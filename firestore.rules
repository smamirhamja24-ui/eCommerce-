rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Role checks
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    function hasRole(role) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData(request.auth.uid).role == role;
    }
    function isAdmin() { return isDeveloper() || hasRole('admin'); }
    function isVendor() { return hasRole('vendor'); }
    function isManager() { return hasRole('manager'); }
    function isDeveloper() { return isSignedIn() && request.auth.token.email == 'smamirhamja24@gmail.com'; }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
             data.keys().size() <= 12 &&
             data.uid == request.auth.uid &&
             (data.role in ['customer', 'vendor'] || (data.role == 'admin' && isDeveloper())) &&
             data.email is string && data.email.size() <= 255 &&
             data.createdAt == request.time;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'stock', 'vendorId', 'createdAt']) &&
             data.name is string && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.stock is int && data.stock >= 0 &&
             (data.vendorId == request.auth.uid || isAdmin()) &&
             data.createdAt == request.time;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'totalAmount', 'status', 'paymentMethod', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.items is list && data.items.size() > 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status == 'pending' &&
             data.createdAt == request.time;
    }

    function isValidCart(data) {
      return data.keys().hasAll(['userId', 'items', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.items is list &&
             data.updatedAt == request.time;
    }

    function isValidWishlist(data) {
      return data.keys().hasAll(['userId', 'items', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.items is list &&
             data.updatedAt == request.time;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['productId', 'userId', 'rating', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.createdAt == request.time;
    }

    // --- Collection Routes ---

    // Users
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && isOwner(userId);
      allow get: if isValidId(userId) && isSignedIn() && !isOwner(userId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && isSignedIn() && (isOwner(userId) || isAdmin()) && (
        (isOwner(userId) && isDeveloper() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phoneNumber', 'address', 'photoURL', 'role', 'createdAt'])) ||
        (isOwner(userId) && !isDeveloper() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phoneNumber', 'address', 'photoURL'])) ||
        isAdmin()
      );
    }

    // Products
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true; // Public listings allowed
      allow create: if isValidId(productId) && (isVendor() || isAdmin()) && isValidProduct(incoming());
      allow update: if isValidId(productId) && (isVendor() || isAdmin()) && (
        (isVendor() && existing().vendorId == request.auth.uid && isValidProduct(incoming())) ||
        isAdmin()
      );
      allow delete: if isValidId(productId) && (isAdmin() || (isVendor() && existing().vendorId == request.auth.uid));
    }

    // Orders
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isManager());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isManager());
      allow create: if isValidId(orderId) && isSignedIn() && isValidOrder(incoming());
      allow update: if isValidId(orderId) && isSignedIn() && (
        (isOwner(existing().userId) && incoming().status == 'cancelled' && existing().status == 'pending' && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
        ((isAdmin() || isManager()) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'trackingId']))
      );
    }

    // Carts
    match /carts/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isOwner(userId);
      allow write: if isValidId(userId) && isOwner(userId) && isValidCart(incoming());
    }

    // Wishlists
    match /wishlists/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isOwner(userId);
      allow write: if isValidId(userId) && isOwner(userId) && isValidWishlist(incoming());
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if isValidId(reviewId);
      allow create: if isValidId(reviewId) && isSignedIn() && isValidReview(incoming());
      allow update, delete: if isValidId(reviewId) && isSignedIn() && (isOwner(existing().userId) || isAdmin());
    }
  }
}
