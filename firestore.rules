rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Role checks
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    function hasRole(role) {
      return isSignedIn() && getUserData(request.auth.uid).role == role;
    }
    function isAdmin() { return hasRole('admin'); }
    function isVendor() { return hasRole('vendor'); }
    function isManager() { return hasRole('manager'); }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
             data.keys().size() <= 10 &&
             data.uid == request.auth.uid &&
             data.role in ['customer', 'vendor'] && // Users can only self-register as customer or vendor
             data.email is string && data.email.size() <= 255 &&
             data.createdAt == request.time;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'stock', 'vendorId', 'createdAt']) &&
             data.name is string && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.stock is int && data.stock >= 0 &&
             data.vendorId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'totalAmount', 'status', 'paymentMethod', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.items is list && data.items.size() > 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status == 'pending' &&
             data.createdAt == request.time;
    }

    // --- Collection Routes ---

    // Users
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && (
        // Action: Update profile info
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phoneNumber', 'address', 'photoURL'])) ||
        // Action: Admin managing user
        isAdmin()
      );
    }

    // Products
    match /products/{productId} {
      allow read: if true; // Public access to products
      allow create: if (isVendor() || isAdmin()) && isValidProduct(incoming());
      allow update: if (isVendor() || isAdmin()) && (
        // Vendor updating their own product
        (isVendor() && existing().vendorId == request.auth.uid && isValidProduct(incoming())) ||
        // Admin update
        isAdmin()
      );
      allow delete: if isAdmin() || (isVendor() && existing().vendorId == request.auth.uid);
    }

    // Orders
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isManager());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isManager());
      allow create: if isSignedIn() && isValidOrder(incoming());
      allow update: if isSignedIn() && (
        // Action: User cancelling their own order
        (isOwner(existing().userId) && incoming().status == 'cancelled' && existing().status == 'pending' && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
        // Action: Admin/Manager updating status
        ((isAdmin() || isManager()) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'trackingId']))
      );
    }
  }
}
